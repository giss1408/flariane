# Copy to .env for local development. In production these come from Doppler — never commit real values.
# Generate keys with: python -m app.cli gen-keys
FLR_ENV=dev
FLR_API_BASE_URL=http://localhost:8000
FLR_CUSTOMER_APP_URL=http://localhost:3000
FLR_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
FLR_DATABASE_URL=postgresql+asyncpg://flariane:flariane@localhost:5433/flariane
FLR_REDIS_URL=redis://localhost:6380/0
FLR_RATE_LIMIT_STORAGE=redis://localhost:6380/1
FLR_TASK_MODE=inline

FLR_JWT_SECRET=
FLR_FIELD_ENCRYPTION_KEY=
FLR_HASH_KEY=
FLR_WAVE_WEBHOOK_SECRET=

FLR_WAVE_MODE=fake
FLR_WAVE_API_KEY=
FLR_WHATSAPP_MODE=log
FLR_WHATSAPP_TOKEN=
FLR_WHATSAPP_PHONE_NUMBER_ID=
FLR_WHATSAPP_APP_SECRET=
FLR_WHATSAPP_VERIFY_TOKEN=
FLR_PUSH_MODE=log
FLR_FCM_PROJECT_ID=
FLR_FCM_SERVICE_ACCOUNT_JSON=
FLR_STORAGE_MODE=local
